# ============================================================
# Krotak Pro Admin — Environment Variables Example
# ============================================================

# Client-side Firebase Configuration (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local Firebase Emulators (Optional)
VITE_USE_FIREBASE_EMULATORS=false
VITE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080

# Server-side Firebase & API Secrets (api/ serverless functions)
FIREBASE_SERVICE_ACCOUNT=
KROTAK_HMAC_SECRET=
OTP_HASH_SECRET=

# OTP delivery (Twilio Verify). Either AUTH_TOKEN or the API key pair.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CHANNEL=sms
# Ed25519 private key for signed entitlement leases. Name only; never commit a value.
ENTITLEMENT_PRIVATE_KEY=
# Optional lease policy overrides in milliseconds (defaults: 7-day offline grace, 30-day offline cap).
ENTITLEMENT_OFFLINE_GRACE_MS=
ENTITLEMENT_MAX_OFFLINE_MS=
CRON_SECRET=
FCM_DEFAULT_TOPIC=krotak_all_users
FCM_ANDROID_CHANNEL_ID=

# -------------------------------------------------------------
# WhatsApp (server only — never VITE_*)
# -------------------------------------------------------------
# Shared Meta secrets (from Meta Developer Console)
META_APP_ID=
WHATSAPP_META_APP_ID=
META_APP_SECRET=
WHATSAPP_META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
# Keep unset/false until a Meta test-number send has passed.
WHATSAPP_LIVE_SEND=false

# Dispatch / purge service secret (random high-entropy string)
WHATSAPP_DISPATCH_SERVICE_SECRET=

# 32-byte base64 KEK for AES-GCM sealing of per-network access tokens
WHATSAPP_SECRETS_KEK=
# Optional previous KEK during rotation
WHATSAPP_SECRETS_KEK_PREV=
WHATSAPP_SECRETS_KEY_VERSION=1

# Persistent QR gateway (not a Vercel worker; set enabled=true only after PoC)
WHATSAPP_GATEWAY_ENABLED=false
WHATSAPP_GATEWAY_URL=
# Shared with Render GATEWAY_SERVICE_TOKEN; also verifies signed status callbacks.
WHATSAPP_GATEWAY_SERVICE_TOKEN=

# Per-network Access Tokens are NOT env vars — ciphertext under
# whatsapp_network_secrets/{networkId}.whatsappAccessTokenEnc only.
