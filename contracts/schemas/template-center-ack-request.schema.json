{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krotak-pro.vercel.app/contracts/template-center-ack-request.schema.json",
  "schemaVersion": 1,
  "title": "Template center ACK request (Android to Vercel)",
  "description": "POST /api/template-center action=ack. uid/network_id يشتقهما الخادم؛ لا يثق بهوية من جسم الطلب.",
  "type": "object",
  "required": ["action", "ackVersion", "installationId", "releaseId", "payloadHash", "scopeKey", "outcome", "appliedAt", "insertedCount", "conflictCount", "parserRefreshed", "appVersion"],
  "additionalProperties": false,
  "properties": {
    "action": { "const": "ack" },
    "ackVersion": { "const": 1 },
    "installationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "releaseId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "payloadHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "scopeKey": { "type": "string", "pattern": "^(global|network:[A-Za-z0-9_-]{1,128})$" },
    "outcome": { "enum": ["applied", "partially_applied", "failed"] },
    "appliedAt": { "type": "string", "format": "date-time" },
    "insertedCount": { "type": "integer", "minimum": 0 },
    "conflictCount": { "type": "integer", "minimum": 0 },
    "parserRefreshed": { "type": "boolean" },
    "appVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "appBuild": { "type": "integer", "minimum": 0 }
  }
}
