{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krotak-pro.vercel.app/contracts/template-ack.schema.json",
  "schemaVersion": 1,
  "title": "Template center ACK document (Firestore)",
  "description": "Latest-only record at users/{uid}/template_acks/{deviceId}. The writer is Vercel; matched/stale are calculated, not stored.",
  "type": "object",
  "required": ["schema_version", "ack_version", "writer", "device_id", "uid", "network_id", "applied_version_id", "applied_version", "applied_version_code", "payload_hash_sha256", "scope_key", "outcome", "parser_refreshed", "inserted_count", "conflict_count", "app_version", "applied_at", "synced_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "ack_version": { "const": 1 },
    "writer": { "const": "server" },
    "device_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
    "network_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{5,128}$" },
    "applied_version_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "applied_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "applied_version_code": { "type": "integer", "minimum": 1 },
    "payload_hash_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope_key": { "type": "string", "pattern": "^(global|network:[A-Za-z0-9_-]{1,128})$" },
    "outcome": { "enum": ["applied", "partially_applied", "failed"] },
    "parser_refreshed": { "type": "boolean" },
    "inserted_count": { "type": "integer", "minimum": 0 },
    "conflict_count": { "type": "integer", "minimum": 0 },
    "app_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "app_build": { "type": ["integer", "null"], "minimum": 0 },
    "applied_at": { "type": "string", "format": "date-time" },
    "synced_at": { "type": "string", "format": "date-time" },
    "received_at": { "type": "string", "format": "date-time" },
    "last_ack_id": { "type": "string", "maxLength": 128 },
    "previous_version_id": { "type": ["string", "null"], "maxLength": 128 },
    "client_time_skew_ms": { "type": "integer" },
    "idempotency_key": { "type": "string", "maxLength": 300 }
  }
}
