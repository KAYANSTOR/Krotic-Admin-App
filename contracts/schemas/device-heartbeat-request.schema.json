{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krotak-pro.vercel.app/contracts/device-heartbeat-request.schema.json",
  "title": "POST /api/device-heartbeat — request body",
  "schemaVersion": 1,
  "description": "Authorization: Bearer <Firebase ID token>. Diagnostic only: never grants or removes access. Accepted at most once per 15 minutes per installation (extra calls are acknowledged without a write). Must not carry secrets, tokens or customer data.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "installationId",
    "accountId",
    "networkId",
    "appVersion",
    "releaseId",
    "pendingCount",
    "unknownDeliveryCount",
    "riskSignals",
    "lastSeenAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "installationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "accountId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "networkId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "appVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pendingCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "unknownDeliveryCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "riskSignals": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      }
    },
    "lastSeenAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastSyncAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "oldestPendingAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastError": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
