{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krotak-pro.vercel.app/contracts/sms-device-task.schema.json",
  "title": "Firestore whatsapp_sms_device_tasks/{deliveryOperationId}",
  "schemaVersion": 1,
  "description": "Created once by the server when WhatsApp delivery misses its deadline. The owner's Android device claims it, sends the same card text by SMS and reports sent|failed. The delivery operation becomes sms_sent only from that device result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "deliveryOperationId",
    "networkId",
    "ownerUid",
    "toLocalPhone",
    "body",
    "status",
    "claimOwnerDeviceId",
    "claimUntilMs",
    "deviceSentAtMs",
    "deviceError",
    "createdAtMs",
    "updatedAtMs"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "deliveryOperationId": {
      "type": "string",
      "minLength": 1
    },
    "networkId": {
      "type": "string",
      "minLength": 1
    },
    "ownerUid": {
      "type": "string",
      "minLength": 1
    },
    "toLocalPhone": {
      "type": "string",
      "minLength": 8
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "status": {
      "enum": [
        "queued",
        "claimed",
        "sent",
        "failed",
        "expired"
      ]
    },
    "claimOwnerDeviceId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "claimUntilMs": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "deviceSentAtMs": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "deviceError": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAtMs": {
      "type": "integer"
    },
    "updatedAtMs": {
      "type": "integer"
    }
  }
}
