{
  "rewrites": [
    { "source": "/api/request-otp", "destination": "/api/manage-user-auth?__apiRoute=request-otp" },
    { "source": "/api/verify-otp", "destination": "/api/manage-user-auth?__apiRoute=verify-otp" },
    { "source": "/api/record-payment", "destination": "/api/settlement?__apiRoute=record-payment" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/dispatch-notifications", "schedule": "0 6 * * *" }
  ],
  "functions": {
    "api/send-fcm.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/dispatch-notifications.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/manage-user-auth.js": {
      "maxDuration": 15,
      "memory": 512
    }
  }
}
