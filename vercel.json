{
  "rewrites": [
    {
      "source": "/api/entitlements/activate",
      "destination": "/api/settings?__apiRoute=entitlement-activate"
    },
    {
      "source": "/api/entitlements/device-rebind",
      "destination": "/api/settings?__apiRoute=entitlement-device-rebind"
    },
    {
      "source": "/api/record-payment",
      "destination": "/api/settlement?__apiRoute=record-payment"
    },
    {
      "source": "/api/template-center",
      "destination": "/api/settings?__apiRoute=template-center"
    },
    {
      "source": "/api/admin/account-features",
      "destination": "/api/settings?__apiRoute=account-features"
    },
    {
      "source": "/api/network-secret",
      "destination": "/api/settings?__apiRoute=network-secret"
    },
    {
      "source": "/api/migrate",
      "destination": "/api/settings?__apiRoute=migrate"
    },
    {
      "source": "/api/device-heartbeats",
      "destination": "/api/device-heartbeat?__apiRoute=list"
    },
    {
      "source": "/api/request-otp",
      "destination": "/api/manage-user-auth?__apiRoute=request-otp"
    },
    {
      "source": "/api/verify-otp",
      "destination": "/api/manage-user-auth?__apiRoute=verify-otp"
    },
    {
      "source": "/api/account-notifications",
      "destination": "/api/manage-user-auth?__apiRoute=account-notifications"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "ignoreCommand": "git show -s --format=%B HEAD | grep -Fq '[otp-no-deploy]'",
  "crons": [
    {
      "path": "/api/dispatch-notifications",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/send-fcm.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/dispatch-notifications.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/manage-user-auth.js": {
      "maxDuration": 15,
      "memory": 512
    },
    "api/whatsapp/meta/webhook.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/whatsapp/delivery/dispatch.js": {
      "maxDuration": 30,
      "memory": 256
    }
  }
}
