rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (exists(/databases/$(database)/documents/Admins/$(request.auth.uid))
         && get(/databases/$(database)/documents/Admins/$(request.auth.uid)).data.uid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
         && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.uid == request.auth.uid)
      );
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function accessFields() {
      return ['accessStatus', 'trialStartedAt', 'subscriptionEndsAt', 'is_active',
              'is_trial', 'commission_rate', 'warning_message', 'has_custom_warning',
              'feature_entitlements', 'feature_entitlements_updated_at',
              'feature_entitlements_updated_by', 'account_features',
              'account_features_version', 'account_features_updated_at_ms',
              'account_features_updated_by', 'account_features_source',
              'networkId', 'network_id', 'entitlementInstallationId', 'entitlementInstallationBoundAt',
              'entitlementVersion', 'entitlementPreviousInstallationId',
              'entitlementReboundAt', 'entitlementReboundAtMs', 'entitlementReboundBy',
              'entitlementLeaseRevokedAtMs',
              'phone_verified', 'phoneVerified', 'phone_verification_required',
              'phone_verified_at', 'phone_verified_sms', 'phone_verified_manual',
              'verified_by_admin', 'verified_by_admin_uid',
              'phone_unverified_at', 'phone_unverified_by'];
    }
    function touchesAccessFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(accessFields());
    }
    function onlyProfileFields() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['phone', 'network_name', 'platform', 'app_version', 'app_version_code', 'last_seen_at'])
        && (!changed.hasAny(['app_version_code']) || request.resource.data.app_version_code is int);
    }

    function isNetworkOwner(networkId) {
      return signedIn() && (
        request.auth.uid == networkId
        || (exists(/databases/$(database)/documents/networks/$(networkId))
            && get(/databases/$(database)/documents/networks/$(networkId)).data.owner_uid == request.auth.uid)
      );
    }

    function validSelfRegistration(userId) {
      return request.resource.data.keys().hasAll([
          'uid', 'phone', 'network_name', 'platform', 'app_version', 'created_at', 'last_seen_at'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'phone', 'network_name', 'platform', 'app_version', 'created_at', 'last_seen_at'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.phone is string
        && request.resource.data.network_name is string
        && request.resource.data.platform is string
        && request.resource.data.app_version is string
        && request.resource.data.created_at is timestamp
        && request.resource.data.last_seen_at is timestamp;
    }

    function validSale(saleId) {
      return request.resource.data.keys().hasOnly([
          'saleId', 'customerId', 'cardId', 'faceValue', 'amount',
          'amountMinor', 'currencyCode', 'face_value', 'commission',
          'commissionAmount', 'netAmount', 'status', 'createdAt',
          'created_at', 'source'
        ])
        && !request.resource.data.keys().hasAny([
          'settlement_status', 'is_settled', 'settled', 'settlementId', 'settledAt',
          'settledBy', 'commissionRateBps', 'commissionMinor', 'commissionRiyal',
          'amountRiyal', 'paidRiyal', 'moneyPolicyVersion', 'payloadPolicyVersion', 'verified'
        ])
        && request.resource.data.saleId == saleId
        && request.resource.data.status == 'COMPLETED'
        && request.resource.data.source == 'krotak_app'
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.currencyCode is string
        && request.resource.data.amount == request.resource.data.amountMinor / 100
        && request.resource.data.faceValue == request.resource.data.amountMinor / 100
        && request.resource.data.face_value == request.resource.data.amountMinor / 100
        && request.resource.data.netAmount == request.resource.data.amountMinor / 100
        && request.resource.data.commission == 0
        && request.resource.data.commissionAmount == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.created_at is timestamp
        && request.resource.data.createdAt == request.resource.data.created_at;
    }

    match /Admins/{adminId} {
      allow read: if signedIn() && (adminId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /admins/{adminId} {
      allow read: if signedIn() && (adminId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /app_settings/{document} {
      allow read: if signedIn() && document == 'global_config';
      allow write: if false;
    }

    match /app_settings/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /template_center_drafts/{draftId} {
      allow read, write: if false;
    }
    match /template_center_releases/{releaseId} {
      allow read, write: if false;
    }
    match /template_center_pointers/{scopeKey} {
      allow read, write: if false;
    }
    match /template_center_device_acks/{ackId} {
      allow read, write: if false;
    }
    match /template_center_acks/{ackId} {
      allow read, write: if false;
    }

    match /admin_aggregates/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{path=**}/sales/{saleId} {
      allow read: if isAdmin();
    }
    match /{path=**}/payments/{paymentId} {
      allow read: if isAdmin();
    }

    match /sync_tombstones/{tombstoneId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sale_ingest_registry/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /device_bindings/{installationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /network_registration_phone_index/{phoneHash} {
      allow read, write: if false;
    }

    match /admin_notification_history/{notificationId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /notification_requests/{requestId} {
      allow create, read: if isAdmin();
      allow update: if false;
    }

    match /notification_deliveries/{deliveryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // WhatsApp server-only collections (Admin SDK).
    match /whatsapp_inbound_events/{eventId} {
      allow read, write: if false;
    }
    match /whatsapp_delivery_operations/{operationId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /whatsapp_delivery_queue/{jobId} {
      allow read, write: if false;
    }
    match /whatsapp_network_secrets/{networkId} {
      allow read, write: if false;
    }
    match /whatsapp_status_events/{eventId} {
      allow read, write: if false;
    }

    // Non-secret gateway session status (option 1). Service writes via Admin SDK only.
    match /whatsapp_gateway_sessions/{networkId} {
      allow read: if isAdmin() || isNetworkOwner(networkId);
      allow write: if false;
    }

    // SMS device tasks: owner reads; device may update claim/result fields only.
    match /whatsapp_sms_device_tasks/{taskId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'claimOwnerDeviceId', 'claimUntilMs',
                       'deviceSentAtMs', 'deviceError', 'updatedAtMs'])
        && request.resource.data.status in ['claimed', 'sent', 'failed']
        && request.resource.data.taskId == resource.data.taskId
        && request.resource.data.deliveryOperationId == resource.data.deliveryOperationId
        && request.resource.data.networkId == resource.data.networkId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.toLocalPhone == resource.data.toLocalPhone
        && request.resource.data.body == resource.data.body;
      allow create, delete: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create: if isSelf(userId) && validSelfRegistration(userId);
      allow update: if !touchesAccessFields()
        && (isAdmin() || (isSelf(userId) && onlyProfileFields()));
      allow delete: if isAdmin();

      match /devices/{deviceId} {
        allow read, create, update, delete: if isAdmin() || isSelf(userId);
      }

      match /notifications/{notificationId} {
        allow read: if isAdmin() || isSelf(userId);
        allow update: if isAdmin() || (isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read'])
          && request.resource.data.is_read is bool);
        allow create, delete: if isAdmin();
      }

      match /{subcollection}/{documentId} {
        allow read: if isAdmin();
        allow write: if isAdmin()
          && subcollection != 'template_acks'
          && subcollection != 'account_feature_audit'
          && subcollection != 'account_features'
          && subcollection != 'feature_entitlements';
      }
    }

    match /networks/{networkId} {
      allow read: if isAdmin() || isNetworkOwner(networkId);
      allow write: if false;

      match /_metadata/{documentId} {
        allow read, write: if isAdmin() || isNetworkOwner(networkId);
      }

      match /sales/{saleId} {
        allow read: if isAdmin() || isNetworkOwner(networkId);
        allow create: if isAdmin() || (isNetworkOwner(networkId) && validSale(saleId));
        allow update: if isAdmin() || (isNetworkOwner(networkId)
          && validSale(saleId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([]));
        allow delete: if false;
      }

      match /payments/{paymentId} {
        allow read: if isAdmin() || isNetworkOwner(networkId);
        allow write: if false;
      }

      match /inventory_snapshot/{documentId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /settlements/{settlementId} {
        allow read: if isAdmin() || isNetworkOwner(networkId);
        allow write: if false;
      }

      match /{subcollection}/{documentId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
  }
}
