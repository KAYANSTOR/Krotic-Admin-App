rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/Admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/Admins/$(request.auth.uid)).data.uid == request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Admin identity documents must use the Firebase Auth UID as their document ID.
    match /Admins/{adminId} {
      allow read: if signedIn() && (adminId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && adminId == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() && adminId != request.auth.uid;
    }

    // Global settings are readable by any signed-in app account (trial config,
    // maintenance state, admin notifications). Only admins may write them.
    match /app_settings/{document=**} {
      allow read: if isAdmin() || signedIn();
      allow write: if isAdmin();
    }

    match /notification_requests/{requestId} {
      allow create, read: if isAdmin();
      allow update: if false;
    }

    match /notification_deliveries/{deliveryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || isSelf(userId);

      // Self-registration: the network owner creates only their own document,
      // and the trial window is bounded by the rules themselves.
      allow create: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.trial_days is int
        && request.resource.data.trial_days >= 0
        && request.resource.data.trial_days <= 30
        && request.resource.data.subscription_end_date is timestamp
        && request.resource.data.subscription_end_date <= request.time + duration.value(30, 'd');

      // The owner may refresh only non-privileged profile fields. Activation,
      // trial state and subscription dates stay admin-only.
      allow update: if isAdmin() || (isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['phone', 'network_name', 'platform', 'app_version', 'last_seen_at']));

      allow delete: if isAdmin();

      // Device tokens for remote notifications: the owner manages its own.
      match /devices/{deviceId} {
        allow read, create, update, delete: if isAdmin() || isSelf(userId);
      }

      // Admin notifications addressed to this account: read-only for the owner.
      match /notifications/{notificationId} {
        allow read: if isAdmin() || isSelf(userId);
        allow update: if isAdmin() || (isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']));
        allow create, delete: if isAdmin();
      }

      match /{subcollection}/{documentId} {
        allow read, write: if isAdmin();
      }
    }

    match /networks/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow write: if isAdmin();

      // Network display metadata is written by the owning app account.
      match /_metadata/{documentId} {
        allow read, write: if isAdmin() || isSelf(userId);
      }

      // مبيعات التطبيق تُرفع من حساب الشبكة ليظهر في فوترة العمولات.
      match /sales/{saleId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create, update: if isAdmin() || isSelf(userId);
        allow delete: if isAdmin();
      }

      // المدفوعات تُسجَّل من لوحة الإدارة فقط؛ الشبكة تقرأها.
      match /payments/{paymentId} {
        allow read: if isAdmin() || isSelf(userId);
        allow write: if isAdmin();
      }

      match /{subcollection}/{documentId} {
        allow read, write: if isAdmin();
      }
    }
  }
}
