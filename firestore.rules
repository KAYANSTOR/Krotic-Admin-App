rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/Admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/Admins/$(request.auth.uid)).data.uid == request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Must match the fields written by the current Android registration flow.
    // Privileged fields (commission, role, subscription, activation overrides)
    // are deliberately not accepted from a self-registering account.
    function validSelfRegistration(userId) {
      return request.resource.data.keys().hasAll([
          'uid', 'phone', 'network_name', 'is_active', 'is_trial',
          'platform', 'app_version', 'created_at', 'last_seen_at'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'phone', 'network_name', 'is_active', 'is_trial',
          'platform', 'app_version', 'created_at', 'last_seen_at'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.phone is string
        && request.resource.data.network_name is string
        && request.resource.data.is_active == true
        && request.resource.data.is_trial == false
        && request.resource.data.platform is string
        && request.resource.data.app_version is string
        && request.resource.data.created_at is timestamp
        && request.resource.data.last_seen_at is timestamp;
    }

    // The Android client may upload completed sales for its own account, but
    // can only create a constrained record and cannot revise an existing sale.
    // Client-originated sales are still not an authoritative financial ledger;
    // use a trusted server to independently verify them before billing.
    function validSale(saleId) {
      return request.resource.data.keys().hasOnly([
          'saleId', 'customerId', 'cardId', 'faceValue', 'amount',
          'amountMinor', 'currencyCode', 'face_value', 'commission',
          'commissionAmount', 'netAmount', 'status', 'createdAt',
          'created_at', 'source'
        ])
        && request.resource.data.saleId == saleId
        && request.resource.data.status == 'COMPLETED'
        && request.resource.data.source == 'krotak_app'
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.currencyCode is string
        && request.resource.data.amount == request.resource.data.amountMinor / 100
        && request.resource.data.faceValue == request.resource.data.amountMinor / 100
        && request.resource.data.face_value == request.resource.data.amountMinor / 100
        && request.resource.data.netAmount == request.resource.data.amountMinor / 100
        && request.resource.data.commission == 0
        && request.resource.data.commissionAmount == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.created_at is timestamp
        && request.resource.data.createdAt == request.resource.data.created_at;
    }

    // Admin identity documents can only be provisioned by an existing admin.
    // The first admin must be provisioned out-of-band with trusted credentials.
    match /Admins/{adminId} {
      allow read: if signedIn() && (adminId == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        && adminId != request.auth.uid
        && request.resource.data.uid == adminId
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'phone', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.createdAt is int;
      allow update: if isAdmin()
        && request.resource.data.uid == adminId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'phone']);
      allow delete: if isAdmin() && adminId != request.auth.uid;
    }

    // Root app settings (e.g. maintenance/commission config) are readable by
    // signed-in app accounts. Nested archives and notification history are
    // admin-only, so a new account cannot read old global notifications.
    match /app_settings/{document} {
      allow read: if signedIn() && document == 'global_config';
      allow write: if isAdmin();
    }

    match /app_settings/{document=**} {
      allow read, write: if isAdmin();
    }

    match /admin_notification_history/{notificationId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /notification_requests/{requestId} {
      allow create, read: if isAdmin();
      allow update: if false;
    }

    match /notification_deliveries/{deliveryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create: if isSelf(userId) && validSelfRegistration(userId);

      // Owners may refresh only profile/presence fields; billing and access
      // status remain admin-controlled.
      allow update: if isAdmin() || (isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['phone', 'network_name', 'platform', 'app_version', 'last_seen_at'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])
          || request.resource.data.phone is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['network_name'])
          || request.resource.data.network_name is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['platform'])
          || request.resource.data.platform is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['app_version'])
          || request.resource.data.app_version is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['last_seen_at'])
          || request.resource.data.last_seen_at is timestamp));

      allow delete: if isAdmin();

      // Device tokens are scoped to the owning account.
      match /devices/{deviceId} {
        allow read, create, update, delete: if isAdmin() || isSelf(userId);
      }

      // Users can read their own inbox and toggle only its read flag.
      match /notifications/{notificationId} {
        allow read: if isAdmin() || isSelf(userId);
        allow update: if isAdmin() || (isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read'])
          && request.resource.data.is_read is bool);
        allow create, delete: if isAdmin();
      }

      match /{subcollection}/{documentId} {
        allow read, write: if isAdmin();
      }
    }

    match /networks/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow write: if isAdmin();

      match /_metadata/{documentId} {
        allow read, write: if isAdmin() || isSelf(userId);
      }

      match /sales/{saleId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create: if isAdmin() || (isSelf(userId) && validSale(saleId));
        allow update: if isAdmin() || (isSelf(userId)
          && validSale(saleId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([]));
        allow delete: if isAdmin();
      }

      match /payments/{paymentId} {
        allow read: if isAdmin() || isSelf(userId);
        allow write: if isAdmin();
      }

      match /{subcollection}/{documentId} {
        allow read, write: if isAdmin();
      }
    }
  }
}
